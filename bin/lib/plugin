# shellcheck disable=SC2034  # The variables are read by the scripts sourcing this
#
# Shared wiring for the local-install scripts: where this plugin lives, what
# it is called, how it takes the stock clock's place in shell.json, and how
# to poke the running shell.
#
# A bar widget is enabled by having an entry in shell.json's bar.layout and
# nothing else, so swapping this widget in for the stock clock is one
# in-place edit of that entry. The stock entry, with its format settings and
# position, is kept in a state file so uninstall can put it back exactly.

set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PLUGIN_ID="$(jq -r '.id' "$PLUGIN_ROOT/manifest.json")"
PLUGINS_DIR="$HOME/.config/omarchy/plugins"
PLUGIN_LINK="$PLUGINS_DIR/$PLUGIN_ID"
SHELL_JSON="$HOME/.config/omarchy/shell.json"
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-binary-clock/replaced-clock.json"
STOCK_CLOCK="omarchy.clock"

require_omarchy() {
	if ! command -v omarchy >/dev/null; then
		echo "omarchy not installed" >&2
		exit 1
	fi
}

# What sits at the plugin's slot in the plugins folder: "ours" for a link to
# this checkout, "missing" for nothing, "foreign" for anything else. Every
# command decides from the same answer, and nothing but "ours" is ever removed.
link_state() {
	if [[ -L $PLUGIN_LINK && "$(readlink -f "$PLUGIN_LINK")" == "$PLUGIN_ROOT" ]]; then
		echo ours
	elif [[ -e $PLUGIN_LINK || -L $PLUGIN_LINK ]]; then
		echo foreign
	else
		echo missing
	fi
}

require_linked() {
	if [[ "$(link_state)" != ours ]]; then
		echo "$PLUGIN_ID is not linked to $PLUGIN_ROOT; run bin/install first" >&2
		exit 1
	fi
}

# The rescan is asynchronous, so wait for the shell to discover the plugin
# before asking it to do anything with it.
rescan_plugins() {
	omarchy-shell shell rescanPlugins >/dev/null
	for _ in $(seq 40); do
		if omarchy plugin list --json | jq -e --arg id "$PLUGIN_ID" 'any(.[]; .id == $id)' >/dev/null; then
			return 0
		fi
		sleep 0.05
	done
	echo "$PLUGIN_ID is not known to the shell after rescan" >&2
	exit 1
}

# Rewrite shell.json with a jq program, then have the shell read it back.
# Every layout change goes through here, in one write, so the shell never
# rewrites the file from a stale copy halfway through.
edit_shell_json() {
	local program="$1"
	shift
	local tmp
	tmp="$(mktemp)"
	jq --indent 2 "$@" "$program" "$SHELL_JSON" >"$tmp"
	mv "$tmp" "$SHELL_JSON"
	omarchy-shell shell reloadConfig >/dev/null
}

# The layout entry for a widget id, or null when it is not enabled.
layout_entry() {
	local id="$1"
	jq -c --arg id "$id" '[.bar.layout[]?[]? | select(.id == $id)][0] // null' "$SHELL_JSON"
}

# Replace one widget's entry with another entry, keeping its place in the
# layout. With no entry to replace, the new one is appended to the center.
replace_layout_entry() {
	local id="$1" entry="$2"
	# shellcheck disable=SC2016  # $id and $entry are jq variables
	edit_shell_json '
		if any(.bar.layout[]?[]?; .id == $id) then
			.bar.layout |= map_values(map(if .id == $id then $entry else . end))
		else
			.bar.layout.center += [$entry]
		end
		| if .bar.centerAnchor == $id then .bar.centerAnchor = $entry.id else . end
	' --arg id "$id" --argjson entry "$entry"
}

# Take one widget out of the layout, and out of the center anchor if it held it.
remove_layout_entry() {
	local id="$1" anchor="$2"
	# shellcheck disable=SC2016  # $id and $anchor are jq variables
	edit_shell_json '
		.bar.layout |= map_values(map(select(.id != $id)))
		| if .bar.centerAnchor == $id then .bar.centerAnchor = $anchor else . end
	' --arg id "$id" --arg anchor "$anchor"
}
